# Kaggle API Token (новий формат токена: KGAT_...)
# Отримайте його на Kaggle: Settings -> API -> Create New Token
KAGGLE_API_TOKEN=your_kaggle_api_token_here

# Ключ YouTube Data API v3 (необов'язково, але рекомендовано для швидкого update_db.py)
# Отримайте його в Google Cloud Console
YOUTUBE_API_KEY=your_youtube_api_key_here
