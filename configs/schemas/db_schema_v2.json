{
  "version": "2.0",
  "status": "current-plus-planned",
  "migration_policy": {
    "runner": "scripts/migrate_db.py",
    "migrations_dir": "migrations/",
    "schema_table": "schema_migrations",
    "schema_table_fields": {
      "version": "TEXT PRIMARY KEY",
      "applied_at": "TEXT NOT NULL",
      "checksum": "TEXT NOT NULL"
    },
    "production_rule": "use --apply explicitly; default is dry-run"
  },
  "current_sqlite_tables": {
    "channels": {
      "primary_key": "channel_id",
      "fields": {
        "channel_id": "TEXT PRIMARY KEY",
        "channel_name": "TEXT NOT NULL",
        "channel_handle": "TEXT",
        "created_at": "TEXT DEFAULT (datetime('now', 'localtime'))",
        "synced": "INTEGER DEFAULT 0",
        "avatar_url": "TEXT",
        "banner_url": "TEXT",
        "subscribers": "INTEGER",
        "video_count": "INTEGER",
        "view_count": "INTEGER",
        "description": "TEXT"
      }
    },
    "videos": {
      "primary_key": "video_id",
      "fields": {
        "video_id": "TEXT PRIMARY KEY",
        "channel_id": "TEXT NOT NULL",
        "title": "TEXT NOT NULL",
        "description": "TEXT",
        "published_at": "TEXT",
        "duration": "INTEGER",
        "view_count": "INTEGER",
        "like_count": "INTEGER",
        "comment_count": "INTEGER",
        "tags": "TEXT",
        "scraped_at": "TEXT DEFAULT (datetime('now', 'localtime'))",
        "updated_at": "TEXT DEFAULT (datetime('now', 'localtime'))",
        "raw_data": "TEXT",
        "synced": "INTEGER DEFAULT 0",
        "full_description": "TEXT",
        "views_update": "TEXT",
        "thumbnail_text": "TEXT",
        "top_comments": "TEXT"
      },
      "foreign_keys": {
        "channel_id": "channels.channel_id"
      }
    },
    "video_phrases": {
      "primary_key": "video_id, phrase, source",
      "fields": {
        "video_id": "TEXT NOT NULL",
        "phrase": "TEXT NOT NULL",
        "ngram_type": "INTEGER NOT NULL",
        "source": "TEXT NOT NULL"
      }
    },
    "agent_chats": {
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "role": "TEXT",
        "provider": "TEXT",
        "model": "TEXT",
        "user_message": "TEXT",
        "assistant_answer": "TEXT",
        "created_at": "TEXT DEFAULT (datetime('now', 'localtime'))"
      }
    },
    "users": {
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "email": "TEXT UNIQUE NOT NULL",
        "role": "TEXT NOT NULL",
        "tag": "TEXT",
        "google_id": "TEXT",
        "avatar_url": "TEXT",
        "created_at": "TEXT DEFAULT (datetime('now', 'localtime'))"
      }
    },
    "user_invites": {
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "token": "TEXT UNIQUE NOT NULL",
        "email": "TEXT UNIQUE NOT NULL",
        "role": "TEXT NOT NULL DEFAULT 'user'",
        "tag": "TEXT",
        "created_at": "TEXT DEFAULT (datetime('now', 'localtime'))",
        "used_at": "TEXT DEFAULT NULL"
      }
    },
    "system_metrics": {
      "fields": {
        "id": "INTEGER PRIMARY KEY",
        "timestamp": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP",
        "cpu_percent": "REAL",
        "ram_mb_used": "REAL",
        "disk_io_mb": "REAL",
        "http_sessions_active": "INTEGER"
      }
    },
    "agent_feedback_memory": {
      "fields": {
        "id": "INTEGER PRIMARY KEY",
        "prompt_text": "TEXT NOT NULL",
        "response_text": "TEXT NOT NULL",
        "model_id": "TEXT",
        "provider_id": "TEXT",
        "feedback_type": "TEXT",
        "latency_ms": "INTEGER",
        "created_at": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "leaked_quota_errors": {
      "fields": {
        "id": "INTEGER PRIMARY KEY",
        "error_string": "TEXT",
        "provider_id": "TEXT",
        "detected_at": "TIMESTAMP DEFAULT CURRENT_TIMESTAMP",
        "intercepted_count": "INTEGER DEFAULT 0"
      }
    }
  },
  "planned_tables": {
    "schema_migrations": "versioned migration records created by scripts/migrate_db.py",
    "dashboard_widgets": "DB-backed widget layout/state after localStorage fallback remains stable",
    "chat_rooms": "team/group chat after server-side RBAC exists",
    "chat_room_members": "room membership after users/session model is enforced",
    "chat_messages": "team messages and AI responses after room model exists",
    "telemetry_logs": "sanitized bug/feature/perf telemetry after privacy rules are enforced"
  },
  "target_schema_tables": {
    "sources": {
      "migration": "migrations/0002_governance_registry.sql",
      "primary_key": "id",
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "type": "TEXT NOT NULL",
        "name": "TEXT NOT NULL",
        "policy_tier": "TEXT NOT NULL CHECK IN A,B,C,D,E,X",
        "status": "TEXT NOT NULL DEFAULT 'pending'",
        "owner_user_id": "INTEGER",
        "source_url": "TEXT",
        "external_id": "TEXT",
        "retention_days": "INTEGER",
        "terms_url": "TEXT",
        "policy_notes": "TEXT",
        "created_at": "TEXT DEFAULT localtime",
        "updated_at": "TEXT DEFAULT localtime"
      },
      "foreign_keys": {
        "owner_user_id": "users.id"
      }
    },
    "source_credentials": {
      "migration": "migrations/0002_governance_registry.sql",
      "primary_key": "id",
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "source_id": "INTEGER NOT NULL",
        "secret_ref": "TEXT NOT NULL",
        "byok": "INTEGER NOT NULL DEFAULT 1",
        "rotation_status": "TEXT NOT NULL DEFAULT 'not_required'",
        "last_rotated_at": "TEXT",
        "expires_at": "TEXT",
        "created_at": "TEXT DEFAULT localtime"
      },
      "foreign_keys": {
        "source_id": "sources.id ON DELETE CASCADE"
      }
    },
    "source_records": {
      "migration": "migrations/0002_governance_registry.sql",
      "primary_key": "id",
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "source_id": "INTEGER NOT NULL",
        "external_record_id": "TEXT",
        "record_type": "TEXT NOT NULL",
        "title": "TEXT",
        "url": "TEXT",
        "published_at": "TEXT",
        "captured_at": "TEXT DEFAULT localtime",
        "content_hash": "TEXT",
        "metadata_json": "TEXT"
      },
      "foreign_keys": {
        "source_id": "sources.id ON DELETE CASCADE"
      }
    },
    "connector_runs": {
      "migration": "migrations/0002_governance_registry.sql",
      "primary_key": "id",
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "source_id": "INTEGER",
        "job_type": "TEXT NOT NULL",
        "status": "TEXT NOT NULL DEFAULT 'queued'",
        "records_seen": "INTEGER DEFAULT 0",
        "records_created": "INTEGER DEFAULT 0",
        "records_updated": "INTEGER DEFAULT 0",
        "cost_estimate": "REAL DEFAULT 0",
        "error_message": "TEXT",
        "started_at": "TEXT",
        "ended_at": "TEXT",
        "created_at": "TEXT DEFAULT localtime"
      },
      "foreign_keys": {
        "source_id": "sources.id ON DELETE SET NULL"
      }
    },
    "audit_events": {
      "migration": "migrations/0002_governance_registry.sql",
      "primary_key": "id",
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "actor_id": "INTEGER",
        "action": "TEXT NOT NULL",
        "object_type": "TEXT NOT NULL",
        "object_id": "TEXT",
        "metadata_json": "TEXT",
        "created_at": "TEXT DEFAULT localtime"
      },
      "foreign_keys": {
        "actor_id": "users.id"
      }
    },
    "ai_outputs": {
      "migration": "migrations/0002_governance_registry.sql",
      "primary_key": "id",
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "output_type": "TEXT NOT NULL",
        "title": "TEXT",
        "prompt_hash": "TEXT",
        "provider_id": "TEXT",
        "model_id": "TEXT",
        "status": "TEXT NOT NULL DEFAULT 'draft'",
        "content_text": "TEXT NOT NULL",
        "metadata_json": "TEXT",
        "created_by": "INTEGER",
        "created_at": "TEXT DEFAULT localtime"
      },
      "foreign_keys": {
        "created_by": "users.id"
      }
    },
    "evidence_links": {
      "migration": "migrations/0002_governance_registry.sql",
      "primary_key": "id",
      "fields": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "ai_output_id": "INTEGER NOT NULL",
        "source_id": "INTEGER",
        "source_record_id": "INTEGER",
        "video_id": "TEXT",
        "claim_text": "TEXT",
        "evidence_text": "TEXT",
        "confidence": "REAL",
        "created_at": "TEXT DEFAULT localtime"
      },
      "foreign_keys": {
        "ai_output_id": "ai_outputs.id ON DELETE CASCADE",
        "source_id": "sources.id ON DELETE SET NULL",
        "source_record_id": "source_records.id ON DELETE SET NULL",
        "video_id": "videos.video_id"
      }
    }
  },
  "hard_blocks": [
    "Do not create team chat tables before RBAC/session enforcement.",
    "Do not apply migrations directly from this JSON file.",
    "Do not add Tauri, tunnel, or OTA schema in the same patch as RBAC."
  ]
}
